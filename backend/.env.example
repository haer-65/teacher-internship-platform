DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teacher_internship_platform
DB_USERNAME=root
DB_PASSWORD=root

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

JWT_SECRET=ReplaceThisWithAtLeast32CharactersSecretKey!
JWT_EXPIRE_SECONDS=7200

FILE_STORAGE_ROOT=D:/teacher-internship-platform/uploads
FILE_MAX_SIZE_MB=20

NOTICE_DEADLINE_REMINDER_DAYS=3
NOTICE_DEADLINE_REMINDER_CRON=0 0 8 * * ?
NOTICE_EMAIL_ENABLED=false
NOTICE_EMAIL_FROM=no-reply@internship.local

APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_SCRIPT_LOCATION=classpath:/db/bootstrap/V*__*.sql
